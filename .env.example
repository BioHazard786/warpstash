# ==============================================================================
# Warpstash Configuration
# ==============================================================================

# Server & Network
# Bare metal: the port Warpstash listens on. Docker Compose: the port published on the host
# (the container always listens on 8080 inside), e.g. 8081 if something else owns 8080.
WARPSTASH_PORT=8080
# Public URL used in share links, e.g. https://stash.warplabs.info
WARPSTASH_BASE_URL=http://localhost:8080
WARPSTASH_TRUST_PROXY=false

# Local Storage Paths (Bare-metal/local dev; Docker mounts /data)
WARPSTASH_STORAGE_PATH=./data/storage
WARPSTASH_DB_PATH=./data/warpstash.db

# Upload Limits (the web UI reads these from /api/info at runtime)
WARPSTASH_MAX_FILE_SIZE_MB=1024
WARPSTASH_MAX_FILES=10
WARPSTASH_MAX_TOTAL_STORAGE_GB=0

# Expiration & Retention
WARPSTASH_DEFAULT_EXPIRY=24h
# Presets shown as buttons; users can also type any duration (90m, 5d, 2w) up to MAX_EXPIRY (0 = unlimited)
WARPSTASH_ALLOWED_EXPIRIES=1h,24h,7d,30d,burn
WARPSTASH_MAX_EXPIRY=30d
WARPSTASH_GC_INTERVAL=60s

# Optional Authentication (Leave empty for public access)
WARPSTASH_AUTH_TOKEN=

# Rate Limiting
WARPSTASH_RATE_LIMIT_RPS=10.0
WARPSTASH_RATE_LIMIT_BURST=30

# Logging (format: text | json; level: debug | info | warn | error)
WARPSTASH_LOG_FORMAT=text
WARPSTASH_LOG_LEVEL=info

# Telegram MTProto Bot (Optional - leave empty to disable)
# Get BOT_TOKEN from @BotFather, APP_ID and APP_HASH from https://my.telegram.org/apps
WARPSTASH_TELEGRAM_BOT_TOKEN=
WARPSTASH_TELEGRAM_APP_ID=
WARPSTASH_TELEGRAM_APP_HASH=
# Optional: Comma-separated list of Telegram user IDs permitted to upload (empty = anyone allowed)
WARPSTASH_TELEGRAM_ALLOWED_USERS=
# Telegram rate limiting per user (RPS = allowed ops/sec per user, BURST = initial burst allowance)
WARPSTASH_TELEGRAM_RATE_LIMIT_RPS=1.0
WARPSTASH_TELEGRAM_RATE_LIMIT_BURST=5
