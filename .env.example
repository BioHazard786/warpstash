# ==============================================================================
# Warpstash Configuration
# ==============================================================================

# Server & Network
WARPSTASH_PORT=8080
WARPSTASH_BASE_URL=http://localhost:8080
WARPSTASH_TRUST_PROXY=false

# Local Storage Paths (Bare-metal/local dev; Docker mounts /data)
WARPSTASH_STORAGE_PATH=./data/storage
WARPSTASH_DB_PATH=./data/warpstash.db

# Upload Limits (Read by backend and Astro frontend build)
WARPSTASH_MAX_FILE_SIZE_MB=1024
WARPSTASH_MAX_FILES=10
WARPSTASH_MAX_TOTAL_STORAGE_GB=0

# Expiration & Retention
WARPSTASH_DEFAULT_EXPIRY=24h
WARPSTASH_ALLOWED_EXPIRIES=1h,12h,24h,72h,burn
WARPSTASH_GC_INTERVAL=60s

# Optional Authentication (Leave empty for public access)
WARPSTASH_AUTH_TOKEN=

# Rate Limiting
WARPSTASH_RATE_LIMIT_RPS=10.0
WARPSTASH_RATE_LIMIT_BURST=30

# Logging (format: text | json; level: debug | info | warn | error)
WARPSTASH_LOG_FORMAT=text
WARPSTASH_LOG_LEVEL=info
