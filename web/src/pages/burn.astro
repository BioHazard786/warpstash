---
import { Button } from "@/components/ui/button";
import {
  Empty,
  EmptyContent,
  EmptyDescription,
  EmptyHeader,
  EmptyMedia,
  EmptyTitle,
} from "@/components/ui/empty";
import Layout from "@/layouts/Layout.astro";
import { IconAlertTriangle, IconFlame } from "@tabler/icons-astro";
---

<Layout
  title="Burn-After-Reading File — Warpstash"
  description="One-time file delivery protected by Warpstash."
>
  <main class="mx-auto flex w-full max-w-3xl flex-1 flex-col justify-center px-4 pt-16 sm:px-6">
    <Empty class="flex-none border-2 border-dashed py-12">
      <EmptyHeader>
        <EmptyMedia
          variant="icon"
          class="text-destructive bg-destructive/10 dark:bg-destructive/20"
        >
          <IconFlame />
        </EmptyMedia>
        <EmptyTitle id="burn-filename" class="max-w-xs truncate text-base">
          Loading file...
        </EmptyTitle>
        <EmptyDescription id="burn-filesize" class="font-mono text-xs" />
        <EmptyDescription class="text-destructive">
          <IconAlertTriangle class="mr-1 inline size-4 align-text-bottom" />
          <strong>Warning:</strong> This file is configured for one-time
          delivery. It will be downloaded and permanently destroyed from the
          server immediately upon viewing.
        </EmptyDescription>
      </EmptyHeader>
      <EmptyContent class="flex-row justify-center gap-2">
        <Button id="burn-download-btn" href="#" as="a" variant="destructive">
          Download & Destroy
        </Button>
        <Button href="/" as="a" variant="outline">
          Back to Home
        </Button>
      </EmptyContent>
    </Empty>
  </main>

  <!-- Embed data slot for backend template injection -->
  <script is:inline id="burn-data" type="application/json">
    {}
  </script>
</Layout>

<script>
  import { formatBytes } from "@/lib/files";

  function initBurnPage() {
    const dataEl = document.getElementById("burn-data");
    let injectedData: {
      id?: string;
      name?: string;
      sizeBytes?: number;
      downloadUrl?: string;
    } = {};
    if (dataEl && dataEl.textContent) {
      try {
        injectedData = JSON.parse(dataEl.textContent);
      } catch {
        // Ignore JSON parse errors
      }
    }

    const params = new URLSearchParams(window.location.search);
    const id = injectedData.id || params.get("id") || "";
    const name =
      injectedData.name ||
      params.get("name") ||
      id ||
      "Burn-after-reading file";
    const sizeBytes =
      injectedData.sizeBytes ?? (Number(params.get("size")) || 0);
    const downloadUrl =
      injectedData.downloadUrl ||
      (id
        ? `/f/${id}${params.get("ext") || ""}?raw=1`
        : `${window.location.pathname}?raw=1`);

    const filenameEl = document.getElementById("burn-filename");
    if (filenameEl) {
      filenameEl.textContent = name;
      filenameEl.title = name;
    }

    const filesizeEl = document.getElementById("burn-filesize");
    if (filesizeEl) {
      const sizeStr = sizeBytes > 0 ? formatBytes(sizeBytes) : "";
      filesizeEl.textContent = sizeStr
        ? `${sizeStr} · Single-Use Delivery`
        : "Single-Use Delivery";
    }

    const downloadBtn = document.getElementById(
      "burn-download-btn",
    ) as HTMLAnchorElement | null;
    if (downloadBtn) {
      downloadBtn.href = downloadUrl;
      downloadBtn.addEventListener("click", () => {
        setTimeout(() => {
          window.location.href = "/410";
        }, 400);
      });
    }
  }

  // Module scripts are deferred, so the DOM is ready by now.
  initBurnPage();
</script>
