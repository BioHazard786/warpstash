---
import Layout from "@/layouts/Layout.astro";
import AsciiLogo from "@/components/AsciiLogo.astro";
import FileUpload from "@/components/FileUpload.astro";
import { ToggleGroup, ToggleGroupItem } from "@/components/ui/toggle-group";
import Section from "@/components/Section.astro";
import {
  CodeBlock,
  CodeBlockActions,
  CodeBlockContent,
  CodeBlockCopyButton,
  CodeBlockLine,
} from "@/components/ui/code-block";

// Configured from environment with fallback
const rawMaxSizeMB =
  import.meta.env.WARPSTASH_MAX_FILE_SIZE_MB ??
  import.meta.env.PUBLIC_MAX_FILE_SIZE_MB;
const rawMaxFiles =
  import.meta.env.WARPSTASH_MAX_FILES ?? import.meta.env.PUBLIC_MAX_FILES;

const parsedMaxSizeMB = rawMaxSizeMB ? parseInt(String(rawMaxSizeMB), 10) : NaN;
const parsedMaxFiles = rawMaxFiles ? parseInt(String(rawMaxFiles), 10) : NaN;

const maxSizeMB =
  !isNaN(parsedMaxSizeMB) && parsedMaxSizeMB > 0 ? parsedMaxSizeMB : 1024;
const maxFiles =
  !isNaN(parsedMaxFiles) && parsedMaxFiles > 0 ? parsedMaxFiles : 10;
---

<Layout title="Warpstash — Ephemeral File Storage">
  <main class="mx-auto flex w-full max-w-3xl flex-1 flex-col gap-10 px-4 pt-16 pb-6 sm:px-6 sm:pt-20">
    <section class="flex flex-col gap-5">
      <AsciiLogo />
      <div class="flex flex-col gap-2">
        <h1 class="font-serif text-2xl tracking-tight text-balance sm:text-3xl">
          Share a file. Let it disappear.
        </h1>
        <p class="text-muted-foreground text-base leading-relaxed text-pretty">
          Fast, minimalist temporary file hosting. Automatic expiry or
          single-use burn-after-reading, direct URLs, zero tracking.
        </p>
      </div>
    </section>

    <FileUpload maxSizeMB={maxSizeMB} maxFiles={maxFiles} />

    <Section title="Terminal">
      <ToggleGroup
        slot="aside"
        id="cli-toggle-group"
        variant="outline"
        size="sm"
        spacing={0}
        defaultValue="curl"
      >
        <ToggleGroupItem value="curl" class="font-mono text-xs">
          curl
        </ToggleGroupItem>
        <ToggleGroupItem value="wget" class="font-mono text-xs">
          wget
        </ToggleGroupItem>
      </ToggleGroup>

      <CodeBlock size="sm">
        <CodeBlockContent>
          <CodeBlockLine>
            <span class="text-muted-foreground select-none">$ </span>
            <span id="cli-cmd"></span>
          </CodeBlockLine>
        </CodeBlockContent>
        <CodeBlockActions>
          <CodeBlockCopyButton id="cli-copy-btn" value="" />
        </CodeBlockActions>
      </CodeBlock>
      <p id="cli-hint" class="text-muted-foreground text-xs"></p>
    </Section>
  </main>
</Layout>

<script>
  const CLI: Record<string, { cmd: (origin: string) => string; hint: string }> =
    {
      curl: {
        cmd: (o) => `curl -F file=@document.pdf ${o}/api/upload`,
        hint: "Returns a direct link. Add -F time=1h or -F burn=true to control expiry.",
      },
      wget: {
        cmd: (o) => `wget --post-file=document.pdf ${o}/api/upload -qO -`,
        hint: "Uploads the raw file body. Add --header='X-Expiry: 1h' to control expiry.",
      },
    };

  let currentTool = "curl";
  const cliToggle = document.getElementById("cli-toggle-group");
  const cmdEl = document.getElementById("cli-cmd");
  const hintEl = document.getElementById("cli-hint");
  const copyBtn = document.getElementById("cli-copy-btn");

  function updateCliDisplay(tool: string) {
    currentTool = tool;
    const cmd = CLI[tool].cmd(window.location.origin);
    if (cmdEl) cmdEl.textContent = cmd;
    if (hintEl) hintEl.textContent = CLI[tool].hint;
    // CodeBlockCopyButton copies whatever data-copy-value holds when clicked
    if (copyBtn) copyBtn.dataset.copyValue = cmd;
  }

  updateCliDisplay("curl");

  cliToggle?.addEventListener("toggle-group:change", (e: any) => {
    const val = e.detail?.value?.[0];
    if (val in CLI) {
      updateCliDisplay(val);
    } else {
      // Don't allow deselecting the active tool.
      cliToggle.dispatchEvent(
        new CustomEvent("toggle-group:set", { detail: { value: currentTool } }),
      );
    }
  });
</script>
