---
import type { HTMLAttributes } from "astro/types";

import { cn } from "@/lib/utils";

type Props = HTMLAttributes<"div">;

const { class: className, ...props } = Astro.props;
---

<div
  data-slot="attachment-group"
  class={cn(
    "gap-3 scroll-px-1 py-1 flex min-w-0 snap-x snap-mandatory overflow-x-auto overscroll-x-contain *:data-[slot=attachment]:flex-none *:data-[slot=attachment]:snap-start",
    className,
  )}
  {...props}
>
  <slot />
</div>
