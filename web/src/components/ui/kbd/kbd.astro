---
import type { HTMLAttributes } from "astro/types";

import { cn } from "@/lib/utils";

type Props = HTMLAttributes<"kbd">;

const { class: className, ...props } = Astro.props;
---

<kbd
  data-slot="kbd"
  class={cn(
    "bg-muted text-muted-foreground in-data-[slot=tooltip-content]:bg-background/20 in-data-[slot=tooltip-content]:text-background dark:in-data-[slot=tooltip-content]:bg-background/10 h-6 w-fit min-w-6 gap-1.5 rounded-md border border-border/60 px-1.5 font-mono text-xs font-medium [&_svg:not([class*='size-'])]:size-3.5 pointer-events-none inline-flex items-center justify-center select-none",
    className,
  )}
  {...props}
>
  <slot />
</kbd>
