---
import { Button } from "@/components/ui/button";
import {
  Sheet,
  SheetContent,
  SheetHeader,
  SheetTitle,
  SheetDescription,
  SheetTrigger,
  SheetFooter,
} from "@/components/ui/sheet";
import {
  IconDownload,
  IconFile,
  IconHistory,
  IconTrash,
  IconCopy,
} from "@tabler/icons-astro";
import {
  Empty,
  EmptyDescription,
  EmptyHeader,
  EmptyMedia,
  EmptyTitle,
} from "@/components/ui/empty";

import {
  Attachment,
  AttachmentAction,
  AttachmentActions,
  AttachmentContent,
  AttachmentDescription,
  AttachmentMedia,
  AttachmentTitle,
} from "@/components/ui/attachment";
---

<Sheet id="history-sheet">
  <SheetTrigger
    id="toggle-history-btn"
    variant="outline"
    size="icon"
    aria-label="Upload history"
  >
    <IconHistory />
  </SheetTrigger>

  <SheetContent side="right">
    <!-- Header -->
    <SheetHeader>
      <SheetTitle>Upload History</SheetTitle>
      <SheetDescription>
        Files uploaded from this browser. Clearing history doesn't delete them
        from the server.
      </SheetDescription>
    </SheetHeader>

    <div class="flex-1 overflow-y-auto p-4">
      <!-- Empty state -->
      <div id="history-empty" class="flex h-full items-center justify-center">
        <Empty>
          <EmptyHeader>
            <EmptyMedia variant="icon">
              <IconHistory />
            </EmptyMedia>
            <EmptyTitle>No uploads in this browser yet</EmptyTitle>
            <EmptyDescription>
              Files you upload will appear here.
            </EmptyDescription>
          </EmptyHeader>
        </Empty>
      </div>

      <!-- Container for history items when length is not 0 -->
      <div id="history-items-container" class="hidden flex-col gap-2.5">
        <!-- Rendered from template -->
      </div>
    </div>

    <!-- Template for history item using Attachment components -->
    <template id="history-item-template">
      <Attachment class="w-full">
        <AttachmentMedia variant="icon">
          <IconFile />
        </AttachmentMedia>
        <AttachmentContent>
          <AttachmentTitle />
          <AttachmentDescription class="font-mono tabular-nums" />
        </AttachmentContent>
        <AttachmentActions>
          <AttachmentAction
            as="a"
            href="#"
            download
            class="history-download-btn"
            title="Download file"
            aria-label="Download file"
          >
            <IconDownload />
          </AttachmentAction>
          <AttachmentAction
            type="button"
            class="history-copy-btn"
            title="Copy link"
            aria-label="Copy link"
          >
            <IconCopy />
          </AttachmentAction>
          <AttachmentAction
            type="button"
            class="history-delete-btn"
            title="Delete file now"
            aria-label="Delete file now"
          >
            <IconTrash />
          </AttachmentAction>
        </AttachmentActions>
      </Attachment>
    </template>

    <!-- Footer Note -->
    <SheetFooter>
      <Button id="clear-history-all-btn" variant="destructive">
        <IconTrash />
        Clear history
      </Button>
    </SheetFooter>
  </SheetContent>
</Sheet>

<script>
  import { cloneIcon, fileIconKey, fileKind, formatBytes } from "@/lib/files";

  interface HistoryRecord {
    id: string;
    name: string;
    size: number;
    url: string;
    deleteToken: string;
    expiresAt: string;
    createdAt: string;
  }

  const KEY = "warpstash_history";

  const toggleBtn = document.getElementById("toggle-history-btn");
  const clearAllBtn = document.getElementById(
    "clear-history-all-btn",
  ) as HTMLButtonElement;
  const container = document.getElementById(
    "history-items-container",
  ) as HTMLDivElement;
  const emptyState = document.getElementById("history-empty") as HTMLDivElement;
  const template = document.getElementById(
    "history-item-template",
  ) as HTMLTemplateElement;

  // Burn-after-reading files are never stored, and expired ones are pruned on read.
  function getHistory(): HistoryRecord[] {
    try {
      const raw: HistoryRecord[] = JSON.parse(
        localStorage.getItem(KEY) || "[]",
      );
      if (!Array.isArray(raw)) return [];

      const now = Date.now();
      const valid = raw.filter((item) => {
        if (!item || !item.id) return false;
        if (!item.expiresAt) return true;
        const exp = new Date(item.expiresAt).getTime();
        return isNaN(exp) || exp > now;
      });

      if (valid.length !== raw.length) {
        localStorage.setItem(KEY, JSON.stringify(valid));
      }

      return valid;
    } catch {
      return [];
    }
  }

  function saveHistory(list: HistoryRecord[]) {
    localStorage.setItem(KEY, JSON.stringify(list));
    render();
  }

  function removeRecord(id: string) {
    saveHistory(getHistory().filter((r) => r.id !== id));
  }

  async function deleteFile(record: HistoryRecord, cardEl: HTMLElement) {
    if (!record.deleteToken) {
      removeRecord(record.id);
      return;
    }

    try {
      const res = await fetch(
        `/api/files/${encodeURIComponent(record.id)}?token=${encodeURIComponent(record.deleteToken)}`,
        { method: "DELETE" },
      );

      // 404/410: already gone server-side (expired or deleted elsewhere); just drop the stale record.
      if (!res.ok && res.status !== 404 && res.status !== 410) {
        let msg = `HTTP ${res.status}`;
        try {
          const data = await res.json();
          if (data.error) msg = data.error;
        } catch {
          // ignore
        }
        throw new Error(msg);
      }

      removeRecord(record.id);
    } catch (err: any) {
      console.error("failed deleting file", err);

      cardEl.setAttribute("data-state", "error");

      const mediaEl = cardEl.querySelector('[data-slot="attachment-media"]');
      if (mediaEl) {
        mediaEl.innerHTML = "";
        mediaEl.appendChild(cloneIcon("error"));
      }

      const descEl = cardEl.querySelector(
        '[data-slot="attachment-description"]',
      );
      if (descEl) {
        descEl.textContent = `Delete failed · ${err.message || "Network error"}`;
      }
    }
  }

  function toggle(el: Element, show: boolean, display: string) {
    el.classList.toggle("hidden", !show);
    el.classList.toggle(display, show);
  }

  function render() {
    if (!container || !emptyState || !clearAllBtn || !template) return;
    const list = getHistory();
    container.innerHTML = "";

    toggle(emptyState, list.length === 0, "flex");
    toggle(container, list.length > 0, "flex");
    clearAllBtn.hidden = list.length === 0;
    clearAllBtn.disabled = list.length === 0;
    if (list.length === 0) return;

    list.forEach((item) => {
      const clone = (template.content.cloneNode(true) as DocumentFragment)
        .firstElementChild as HTMLElement;
      clone.setAttribute("data-id", item.id);

      const mediaEl = clone.querySelector('[data-slot="attachment-media"]');
      if (mediaEl) {
        mediaEl.innerHTML = "";
        mediaEl.appendChild(cloneIcon(fileIconKey(item.name)));
      }

      const titleEl = clone.querySelector('[data-slot="attachment-title"]');
      if (titleEl) {
        titleEl.textContent = item.name;
        titleEl.setAttribute("title", item.name);
      }

      // e.g. "PDF · 2.4 MB"
      const descEl = clone.querySelector(
        '[data-slot="attachment-description"]',
      );
      if (descEl) {
        descEl.textContent = `${fileKind(item.name)} · ${formatBytes(item.size)}`;
      }

      const dlBtn = clone.querySelector(
        ".history-download-btn",
      ) as HTMLAnchorElement | null;
      if (dlBtn) {
        dlBtn.href = item.url;
        dlBtn.setAttribute("download", item.name);
        dlBtn.setAttribute("title", `Download ${item.name}`);
        dlBtn.setAttribute("aria-label", `Download ${item.name}`);
      }

      const copyBtn = clone.querySelector(
        ".history-copy-btn",
      ) as HTMLButtonElement | null;
      if (copyBtn) {
        copyBtn.setAttribute("aria-label", `Copy link for ${item.name}`);
        copyBtn.addEventListener("click", () => {
          // clipboard is undefined on non-HTTPS origins
          if (!navigator.clipboard) return;
          navigator.clipboard.writeText(item.url).catch(() => {});
          const originalContent = copyBtn.innerHTML;
          copyBtn.innerHTML = "";
          copyBtn.appendChild(cloneIcon("check"));
          copyBtn.setAttribute("title", "Copied to clipboard!");
          setTimeout(() => {
            copyBtn.innerHTML = originalContent;
            copyBtn.setAttribute("title", "Copy link");
          }, 2000);
        });
      }

      const delBtn = clone.querySelector(
        ".history-delete-btn",
      ) as HTMLButtonElement | null;
      if (delBtn) {
        delBtn.setAttribute("aria-label", `Delete ${item.name}`);
        delBtn.addEventListener("click", () => deleteFile(item, clone));
      }

      container.appendChild(clone);
    });
  }

  toggleBtn?.addEventListener("click", render);
  clearAllBtn?.addEventListener("click", () => saveHistory([]));
  window.addEventListener("warpstash:history-updated", render);

  render();
</script>
