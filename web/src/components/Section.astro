---
import { cn } from "@/lib/utils";

interface Props {
  title: string;
  class?: string;
}

const { title, class: className } = Astro.props;
---

<section class={cn("flex flex-col gap-3", className)}>
  <div class="border-border flex items-center justify-between gap-3 border-b pb-2">
    <h2 class="text-muted-foreground font-mono text-xs font-normal tracking-wider uppercase">
      {title}
    </h2>
    <slot name="aside" />
  </div>
  <slot />
</section>
